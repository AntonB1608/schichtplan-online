# Kopiere diese Datei nach .env und trag deine eigenen Werte ein.
secret_key=ein_langer_zufaelliger_string
resend_api_key=dein_resend_api_key
# Optional – ohne DATABASE_URL läuft lokal SQLite:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# true, wenn über HTTPS ausgeliefert:
SESSION_COOKIE_SECURE=false
# true nur in der Entwicklung:
FLASK_DEBUG=false
